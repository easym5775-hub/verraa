# ================================================================
# FORGE — environment variables (copy to `.env` and fill in).
#
# Only PUBLIC values belong here. The Supabase SERVICE ROLE key must
# NEVER be placed in this file or anywhere under src/ — it is set only
# as an Edge Function secret:
#
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
# ================================================================

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Your project's public anon key (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=

# --- Deploying on Vercel ---
# Add the SAME two variables in Vercel -> Project -> Settings ->
# Environment Variables (Production + Preview). Never commit real values:
# `.env` is gitignored. After deploying, add your Vercel domain to
# Supabase -> Authentication -> URL Configuration -> Redirect URLs.
